@page
@model PasswordModel
@{
    ViewData["Title"] = "Tong Tin Online";
}

<div style="text-align:center; margin-top:40px;">
    <h1 style="color:#333;">Tong Tin Online</h1>

    <!-- Wheel -->
    <div class="wheel"></div>

    <!-- Input -->
    <form method="post">
        <input type="text" name="PasswordInput" placeholder="Please enter role"
               style="padding:10px; width:250px; border-radius:20px; margin-top:20px;" />
        <br />
        <button type="submit" asp-page-handler="Login"
                style="margin-top:15px; padding:10px 20px; background:black; color:white; border:none;border-radius:20px;">
            Continue
        </button>
    </form>
</div>
<footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TongTinApp - <a asp-area="" asp-page="/Index">Back</a>
        </div>
</footer>
