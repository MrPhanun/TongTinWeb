@page
@model DashboardModel
@{
    ViewData["Title"] = "Tong Tin Online Dashboard";
}

<div style="text-align:center; margin-top:40px;">
    <!-- Title with wheel icon -->
    <h2>
        <span style="margin-right:10px;">🎡</span> Tong Tin Online Dashboard
    </h2>

    <!-- Dashboard buttons -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:30px; max-width:600px; margin-left:auto; margin-right:auto;">
        
        <!-- Left column -->
        <a asp-page="/Members" style="background:#1877f2; color:white; padding:20px; text-decoration:none; border-radius:20px; border:2px solid black;">
            Members
        </a>
        <a asp-page="/Monthly" style="background:#90ee90; color:black; padding:20px; text-decoration:none; border-radius:20px; border:2px solid black;">
            Monthly Payment Schedule
        </a>

        <a asp-page="/Winner" style="background:#ffdab9; color:black; padding:20px; text-decoration:none; border-radius:20px; border:2px solid black;">
            Winner
        </a>
        <a asp-page="/Yearly" style="background:#f0e68c; color:black; padding:20px; text-decoration:none; border-radius:20px; border:2px solid black;">
            Yearly Payment Schedule
        </a>

        <a asp-page="/History" style="background:#dda0dd; color:black; padding:20px; text-decoration:none; border-radius:20px;  border:2px solid black; grid-column:span 2;">
            History
        </a>
    </div>
</div>
<footer class="border-top footer text-muted">
    <a asp-page="/Index" 
       style="background:#87CEEB; color:black; padding:5px; text-decoration:none; border-radius:20px; border:2px solid black; display:inline-flex; align-items:center;">
        <img src="~/images/back.png" alt="Back" style="height:30px;">
        Back
    </a>
</footer>

